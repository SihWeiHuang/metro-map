VITE_MAPBOX_TOKEN=
# Map engine: mapbox (default) | maplibre (experimental stub — requires future maplibre-gl wiring)
# VITE_MAP_ENGINE=mapbox
# VITE_MAPLIBRE_STYLE=https://example.com/style.json
# Optional: npm run dev:reference sets this (same as MRT_REFERENCE_OVERLAY_ON=1 in referenceOverlayConfig.js)
# VITE_MRT_REFERENCE_OVERLAY=true
# Optional: shown on About / Legal / Support pages
VITE_SITE_CONTACT_EMAIL=
# Optional: Ko-fi page URL — enables sponsor button on Support page
VITE_SPONSOR_URL=
# Google Analytics 4 — Measurement ID (G-…) from Admin → Data streams → Web
# VITE_GA4_MEASUREMENT_ID=G-xxxxxxxxxx
# Optional: map right ad sidebar (160×600 skyscraper) — 0 = off, 1 = on (overrides src/site/adSidebarConfig.js when set)
# VITE_AD_SIDEBAR_ON=0
# Google AdSense — required for ads / site review (publisher ID from AdSense dashboard)
# Value: ca-pub-XXXXXXXXXXXXXXXX or pub-XXXXXXXXXXXXXXXX (no quotes)
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# Also generates public/ads.txt at build time (served as /ads.txt)
# Optional: display ad unit slot ID (after creating a 160×600 unit in AdSense)
# VITE_ADSENSE_SLOT=

# Share links (server-side only — set in Vercel after connecting Redis / KV integration)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
